# .env.example — Copiază în .env și completează cu valorile tale
# Nu comite niciodată fișierul .env (e în .gitignore)

# Slack Bot Token (xoxb-...) — din Slack app -> "OAuth & Permissions" -> "Bot User OAuth Token"
SLACK_BOT_TOKEN="xoxb-your-bot-token-here"

# Slack Channel ID (C...) — channel-ul dedicat unde vorbești cu agentul.
# Cum îl găsești: deschide channel-ul în Slack, click pe numele lui din partea de sus,
# iar în josul ferestrei de detalii vezi "Channel ID: C0XXXXXXX".
SLACK_CHANNEL_ID="C0XXXXXXXXX"

# Slack User ID (U...) — ID-ul TĂU de utilizator (doar mesajele tale sunt procesate).
# Cum îl găsești: click pe avatarul tău -> "Profile" -> cele trei puncte (...) -> "Copy member ID".
SLACK_ALLOWED_USER="U0XXXXXXXXX"
